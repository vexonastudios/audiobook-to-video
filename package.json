{
  "name": "audiobook-video-generator",
  "version": "1.2.8",
  "description": "Audiobook to Video by Vexona Studios",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/generate-icons.js",
    "test": "npm run test:render-feedback && npm run test:opening-titles && npm run test:open-output && npm run test:frame-renderer && npm run test:render-pipeline && npm run test:timeline-seek && npm run test:transitions && npm run test:print-promotion && npm run test:legacy-promotion",
    "test:print-promotion": "node --test tests/print-promotion.test.js",
    "test:transitions": "node --test tests/chapter-timeline.test.js && node tests/transition-timing-smoke.js",
    "test:render-feedback": "node --test tests/render-feedback.test.js && electron tests/render-feedback-ui-smoke.js",
    "test:opening-titles": "node tests/opening-titles-smoke.js",
    "test:open-output": "electron tests/open-output-ui-smoke.js",
    "test:frame-renderer": "electron tests/frame-renderer-smoke.js",
    "test:render-pipeline": "node tests/render-pipeline-smoke.js",
    "test:timeline-seek": "node tests/timeline-seek-smoke.js",
    "test:legacy-promotion": "electron tests/legacy-promotion-smoke.js",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^1.4.1",
    "@fontsource/eb-garamond": "^5.1.0",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "electron": "^29.4.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.vexonastudios.videogenerator",
    "productName": "Audiobook to Video by Vexona Studios",
    "asar": true,
    "nsis": {
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "files": [
      "**/*",
      "!node_modules/electron-builder/**"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vexonastudios",
        "repo": "audiobook-to-video",
        "releaseType": "release"
      }
    ]
  }
}
